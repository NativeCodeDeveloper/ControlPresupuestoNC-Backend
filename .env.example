# Variables de entorno para NativeCode Finance - Backend
# Copia este archivo a .env y completa con tus valores

# Base de datos
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=

# JWT
JWT_SECRET=

# Servicios externos
BREVO_API_KEY=

# Health Score - Cifrado de API keys
# IMPORTANTE: Genera una clave única con: node scripts/generate-encryption-key.js
# NUNCA hacer commit de esta clave al repositorio
# NUNCA compartir esta clave con nadie
ENCRYPTION_KEY=your-64-char-hex-key-here

# Otros
NODE_ENV=development
PORT=3001
